<!DOCTYPE html>
<html>
<head>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
    <script src="https://rawgit.com/jeromeetienne/ar.js/1.7.2/aframe/build/aframe-ar.min.js"></script>
</head>
<body style="margin: 0; overflow: hidden;">
    <a-scene embedded arjs>
        <!-- الكاميرا -->
        <a-camera position="0 2 5"></a-camera>

        <!-- كوب يحتوي على NaCl -->
        <a-entity position="-1 0 -3">
            <a-cylinder height="1.5" radius="0.5" color="#87CEEB"></a-cylinder>
        </a-entity>

        <!-- كوب يحتوي على AgNO3 -->
        <a-entity position="1 0 -3">
            <a-cylinder height="1.5" radius="0.5" color="#4682B4"></a-cylinder>
        </a-entity>

        <!-- زر لبدء التفاعل -->
        <a-entity position="0 -1.5 -3">
            <a-box id="mixButton" color="green" depth="0.2" height="0.5" width="2"></a-box>
            <a-text value="اخلط المواد" position="-0.8 0 0.2" scale="1.5 1.5 1.5"></a-text>
        </a-entity>

        <!-- الراسب الأبيض -->
        <a-entity id="precipitate" position="0 -1.5 -3" visible="false">
            <a-sphere radius="0.5" color="white"></a-sphere>
        </a-entity>
    </a-scene>

    <script>
        document.getElementById("mixButton").addEventListener("click", function() {
            document.getElementById("precipitate").setAttribute("visible", "true");
        });
    </script>
</body>
</html>
